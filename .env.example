# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── 토스페이먼츠 v2 결제위젯 ─────────────────────────────────
# 토스페이먼츠 공식 문서에 공개된 테스트 키로 바로 시작할 수 있습니다.
#   클라이언트  test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
#   시크릿      test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# 실제 서비스 전에는 https://developers.tosspayments.com 에서
# 본인 계정의 키로 반드시 교체하세요. 시크릿 키는 서버에서만 사용합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_...
TOSS_SECRET_KEY=test_gsk_...

# ── 사이트 ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
